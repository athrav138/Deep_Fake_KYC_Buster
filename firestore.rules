rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName'])
      );

      function isValidUser(data) {
        return data.keys().hasAll(['fullName', 'email', 'role']) &&
               data.keys().size() == 3 &&
               data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
               data.email is string && data.email.size() <= 100 &&
               data.role in ['user', 'admin'];
      }
    }

    // --- Community Chat ---
    match /chat_channels/community/messages/{messageId} {
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage(request.resource.data);
      
      function isValidMessage(data) {
        return data.senderId == request.auth.uid &&
               data.text is string && data.text.size() <= 1000 &&
               data.timestamp == request.time;
      }
    }

    // --- Support Chat ---
    match /chat_channels/support/sessions/{sessionId}/messages/{messageId} {
      allow read: if isSignedIn() && (sessionId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (sessionId == request.auth.uid || isAdmin()) && isValidMessage(request.resource.data);
      
      function isValidMessage(data) {
        return data.senderId == request.auth.uid &&
               data.text is string && data.text.size() <= 2000 &&
               data.timestamp == request.time;
      }
    }

    // --- Global Activity ---
    match /global_activity/{activityId} {
      allow list: if isSignedIn();
      allow create: if isAdmin(); // Only system/admin can post to main feed for now
    }

    // --- Video Analyses ---
    match /video_analyses/{userId}/results/{analysisId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidAnalysis(request.resource.data);
      
      function isValidAnalysis(data) {
        return data.keys().hasAll(['videoName', 'isDeepfake', 'riskLevel', 'confidenceScore', 'timestamp']) &&
               data.videoName is string && data.videoName.size() <= 255 &&
               data.isDeepfake is bool &&
               data.riskLevel in ['low', 'medium', 'high'] &&
               data.confidenceScore is number &&
               data.timestamp == request.time;
      }
    }

    // --- Admin Helper ---
    function isAdmin() {
      // For this demo, let's assume if they have the 'admin' field in their token OR we check a doc
      // Best practice is to check a doc.
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
